---
import Icon from './Icon.astro';
import { LINKS } from '../lib/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Open source · Self-hosted</p>
      <h1 id="hero-title">Your music, in your own vault.</h1>
      <p class="hero-lead">
        A music library and player for people who keep their own music. A Windows app, an Android
        app and a web app share one account, one library, and the same playlists, favorites and
        listening history.
      </p>
      <p class="hero-sub">
        Your songs live in your own private Cloudflare R2 bucket and your library in your own
        Supabase project. Upload the music you own and play it anywhere, online or off.
      </p>
      <div class="buttons">
        <a class="button button-primary" href="#run">
          Run your own
          <Icon name="arrowRight" />
        </a>
        <a class="button button-secondary" href={LINKS.repo}>
          <Icon name="github" />
          View on GitHub
        </a>
      </div>
      <ul class="hero-facts" aria-label="At a glance">
        <li><Icon name="check" /> Free, MIT license</li>
        <li><Icon name="check" /> Windows · Android · Web</li>
        <li><Icon name="check" /> No analytics</li>
      </ul>
    </div>

    <figure class="hero-shot">
      {/* The demo video's loop (video/README.md makes it). The script below starts
          it unless the visitor asks for reduced motion; without it the poster shows. */}
      <video
        class="frame hero-video"
        muted
        loop
        playsinline
        preload="metadata"
        poster="/video/hero-loop-poster.webp"
        width="1280"
        height="720"
        aria-label="Music Vault in use: searching the library, synced lyrics, the visualizer, the Android player and listening statistics"
      >
        <source src="/video/hero-loop.webm" type="video/webm" />
        <source src="/video/hero-loop.mp4" type="video/mp4" />
      </video>
      <figcaption>Windows, the web and Android. Every song, cover and number shown is invented.</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(56px, 9vw, 104px);
    padding-bottom: clamp(64px, 9vw, 112px);
    background:
      radial-gradient(900px 600px at 6% -10%, var(--glow-1), transparent 70%),
      radial-gradient(800px 600px at 100% 40%, var(--glow-2), transparent 70%);
  }

  .hero-inner {
    display: grid;
    gap: clamp(48px, 7vw, 80px);
  }

  /* The headline takes the full width; the paragraphs keep a readable measure. */
  .hero-lead,
  .hero-sub {
    max-width: 46rem;
  }

  h1 {
    font-size: clamp(2.6rem, 7.2vw, 4.75rem);
    font-weight: 850;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .hero-lead {
    margin-top: 24px;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.5;
    color: var(--fg);
    font-weight: 500;
  }

  .hero-sub {
    margin-top: 14px;
    color: var(--muted);
    font-size: clamp(1rem, 1.6vw, 1.125rem);
  }

  .buttons {
    margin-top: 32px;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .hero-facts :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--accent-text);
  }

  .hero-video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: #0d0d10;
  }

  .hero-shot figcaption {
    margin-top: 16px;
    color: var(--muted);
    font-size: 0.875rem;
    text-align: center;
  }
</style>

<script>
  // Plays only for visitors who haven't asked for reduced motion, and follows
  // that setting if it changes while the page is open.
  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const apply = () => {
    if (!video) return;
    if (reduce.matches) video.pause();
    else void video.play().catch(() => {});
  };
  apply();
  reduce.addEventListener('change', apply);
</script>
