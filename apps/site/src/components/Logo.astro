---
/** The app mark, as drawn in docs/social-preview.html. */
import { nextId } from '../lib/ids';

interface Props {
  size?: number;
}

const { size = 32 } = Astro.props;
// Each instance needs its own gradient id: the logo appears twice on the page.
const id = nextId('logo');
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="logo">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#a78bfa"></stop>
      <stop offset="1" stop-color="#7c3aed"></stop>
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="8" fill={`url(#${id})`}></rect>
  <path
    d="M13 21.5V10.2l9-1.9v11.1"
    fill="none"
    stroke="#fff"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <ellipse cx="10.9" cy="21.6" rx="2.6" ry="2.1" fill="#fff"></ellipse>
  <ellipse cx="19.9" cy="19.6" rx="2.6" ry="2.1" fill="#fff"></ellipse>
</svg>
