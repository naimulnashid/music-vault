---
import Icon, { type IconName } from './Icon.astro';
import { LINKS } from '../lib/site';

const promises: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'database',
    title: 'Stored in your accounts',
    text: 'Audio and covers sit in your R2 bucket; song details, playlists, favorites, play history and sync state in your Supabase project. No server run by this project sees any of it.',
  },
  {
    icon: 'eyeOff',
    title: 'No tracking',
    text: 'The apps contain no analytics and no crash reporting. This page has none either.',
  },
  {
    icon: 'lock',
    title: 'Row-level security',
    text: 'The Supabase anon key is built into every app by design; row-level security, keyed to the signed-in account, is what protects the data.',
  },
  {
    icon: 'key',
    title: 'Keys stay on the server',
    text: 'The R2 keys exist only as Supabase secrets read by the vault function, which hands the apps short-lived signed URLs.',
  },
  {
    icon: 'shield',
    title: 'Checked downloads',
    text: 'Every download is checked against the song’s BLAKE3 hash before it is kept.',
  },
];
---

<section class="section" id="privacy" aria-labelledby="privacy-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Privacy</p>
      <h2 id="privacy-title">Your music stays yours.</h2>
      <p class="lead">
        Music Vault keeps one person's music in their own accounts.
      </p>
    </div>

    <ul class="promises">
      {
        promises.map((item) => (
          <li class="reveal">
            <span class="icon-tile">
              <Icon name={item.icon} />
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <aside class="limits card reveal" aria-labelledby="limits-title">
      <h3 id="limits-title">Know the limits</h3>
      <ul class="ticks">
        <li>
          <strong>Copies on your devices are not encrypted.</strong> The apps keep your library and
          the audio they have cached or downloaded on each device, so anyone with access to the
          device's files can play them.
        </li>
        <li>
          <strong>Turn off sign-ups once your account exists.</strong> Any account on your Supabase
          project can upload into your bucket, and the vault function has no allowlist or storage
          quota. <a href={LINKS.setupSignups}>The setup guide shows how.</a>
        </li>
      </ul>
      <p class="report">
        Found a vulnerability? Report it privately, as described in the{' '}
        <a href={LINKS.security}>security policy</a>.
      </p>
    </aside>
  </div>
</section>

<style>
  .promises {
    display: grid;
    gap: 28px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .promises li {
    display: flex;
    gap: 18px;
  }

  .promises .icon-tile {
    flex-shrink: 0;
    margin: 0;
  }

  .promises h3 {
    margin: 2px 0 8px;
    font-size: 1.125rem;
  }

  .promises p {
    color: var(--muted);
  }

  .limits {
    margin-top: clamp(40px, 5vw, 56px);
    border-color: var(--line-strong);
  }

  .limits h3 {
    margin-bottom: 16px;
  }

  .limits a,
  .report a {
    color: var(--accent-text);
    text-underline-offset: 3px;
  }

  .report {
    margin-top: 20px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  @media (min-width: 760px) {
    .promises {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .promises {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
