---
import '@fontsource-variable/figtree';
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import '../styles/global.css';
// The repository's social preview (1280x640) and the web app's touch icon,
// used as they are so the site, GitHub and the app share one look.
import socialPreview from '../../../../docs/social-preview.png';
import appleIcon from '../../../web/src/app/apple-icon.png';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(socialPreview.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0d0d10" data-scheme="dark" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f6f9" data-scheme="light" media="(prefers-color-scheme: light)" />
    <!-- Before first paint: the theme chosen with the header toggle on an earlier
         visit, if any (ThemeToggle.astro). Inline so the page never flashes the
         other theme. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href={appleIcon.src} />
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(socialPreview.width)} />
    <meta property="og:image:height" content={String(socialPreview.height)} />
    <meta
      property="og:image:alt"
      content="Music Vault: your own music library and player, on Windows, Android and the web"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
