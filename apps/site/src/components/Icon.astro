---
/**
 * Inline icons. Shapes are copied from Lucide (ISC license), the icon set the
 * apps use, so no icon library ships to the browser. GitHub's mark is from
 * GitHub's Octicons (MIT), since Lucide no longer carries brand icons.
 */
const lucide = {
  monitor:
    '<rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>',
  smartphone: '<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>',
