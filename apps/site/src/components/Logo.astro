---
/** The app mark, as drawn in public/favicon.svg (the icon's source). */
import { nextId } from '../lib/ids';

interface Props {
  size?: number;
}

const { size = 32 } = Astro.props;
// Each instance needs its own gradient ids: the logo appears twice on the page.
const id = nextId('logo');
const gloss = nextId('logo');
---

<svg width={size} height={size} viewBox="0 0 512 512" aria-hidden="true" class="logo">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#a78bfa"></stop>
      <stop offset="1" stop-color="#6d28d9"></stop>
    </linearGradient>
    <radialGradient id={gloss} cx=".22" cy=".12" r=".85">
      <stop offset="0" stop-color="#fff" stop-opacity=".3"></stop>
      <stop offset=".55" stop-color="#fff" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <rect width="512" height="512" rx="120" fill={`url(#${id})`}></rect>
  <rect width="512" height="512" rx="120" fill={`url(#${gloss})`}></rect>
  <circle cx="256" cy="256" r="184" fill="#4c1d95" fill-opacity=".3"></circle>
  <circle cx="256" cy="256" r="152" fill="none" stroke="#fff" stroke-opacity=".12" stroke-width="7"></circle>
  <circle cx="256" cy="256" r="118" fill="none" stroke="#fff" stroke-opacity=".12" stroke-width="7"></circle>
  <g transform="translate(8 12)" fill="#2e1065" fill-opacity=".4" stroke="#2e1065" stroke-opacity=".4">
    <path d="M214 340V166l140-30v170" fill="none" stroke-width="36" stroke-linecap="round" stroke-linejoin="round"></path>
    <ellipse cx="180" cy="342" rx="44" ry="35" transform="rotate(-20 180 342)" stroke="none"></ellipse>
    <ellipse cx="320" cy="310" rx="44" ry="35" transform="rotate(-20 320 310)" stroke="none"></ellipse>
  </g>
  <g fill="#fff" stroke="#fff">
    <path d="M214 340V166l140-30v170" fill="none" stroke-width="36" stroke-linecap="round" stroke-linejoin="round"></path>
    <ellipse cx="180" cy="342" rx="44" ry="35" transform="rotate(-20 180 342)" stroke="none"></ellipse>
    <ellipse cx="320" cy="310" rx="44" ry="35" transform="rotate(-20 320 310)" stroke="none"></ellipse>
  </g>
</svg>
